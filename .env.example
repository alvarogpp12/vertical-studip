# Copia este archivo a .env y rellena SOLO las claves de los proveedores que vayas a usar.
# Nunca subas .env a GitHub (ya está en .gitignore).

# --- Cerebro del agente ---
ANTHROPIC_API_KEY=

# --- Vídeo e imagen ---
# fal.ai: Kling 3.0, Seedance (más caro), Seedream/Nano Banana. https://fal.ai/dashboard/keys
FAL_KEY=
# BytePlus ModelArk (API oficial de ByteDance, Seedance más barato). https://console.byteplus.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# IDs exactos de los modelos en tu consola de ModelArk (Model list). Ejemplo de formato: dreamina-seedance-2-5-XXXXXX
ARK_MODEL_SEEDANCE_25=
ARK_MODEL_SEEDANCE_20=
ARK_MODEL_SEEDANCE_20_FAST=

# --- Límites de gasto (USD) ---
# El tope diario tiene que caber por encima del coste de un episodio (30–45 $).
BUDGET_MAX_PER_JOB=3
BUDGET_MAX_PER_DAY=60

# --- Almacenamiento de referencias (los modelos necesitan URLs públicas de imágenes) ---
# Con FAL_KEY basta: `showrunner casting` sube las referencias con fal_client.upload_file().
# R2 queda como opción para archivo canónico versionado o para llamar a ModelArk sin pasar
# por fal. Si no lo usas, deja estas variables vacías.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
